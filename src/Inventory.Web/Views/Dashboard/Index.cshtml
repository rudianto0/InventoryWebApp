@model DashboardSummary
@{
    ViewData["Title"] = "Dashboard";
    var locations = (IReadOnlyList<SelectOption>)ViewBag.Locations;
    var locationId = ViewBag.LocationId as Guid?;
    var iconSprite = Url.Content("~/images/icons.svg");
    var canViewRestrictedReports = User.IsInRole("Admin") || User.IsInRole("Manager")
        || User.IsInRole("Auditor") || User.IsInRole("SPV");
}

<div class="dash-toolbar">
    <div>
        <h4>Dashboard</h4>
        <p class="text-muted">Ringkasan persediaan dan aktivitas stok terkini.</p>
    </div>
    <form method="get" class="dash-filter">
        <select name="locationId" class="form-select form-select-sm" asp-items="@(new SelectList(locations, "Id", "Text", locationId))">
            <option value="">Semua Lokasi</option>
        </select>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <span class="stat-icon" aria-hidden="true">
                <svg><use href="@(iconSprite)#i-package"></use></svg>
            </span>
            <div class="stat-label">Produk Aktif</div>
            <div class="stat-value">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card is-success">
            <span class="stat-icon" aria-hidden="true">
                <svg><use href="@(iconSprite)#i-box"></use></svg>
            </span>
            <div class="stat-label">Total Saldo Stok</div>
            <div class="stat-value">@Model.TotalStockQuantity</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card is-danger">
            <span class="stat-icon" aria-hidden="true">
                <svg><use href="@(iconSprite)#i-alert"></use></svg>
            </span>
            <div class="stat-label">Di Bawah Reorder</div>
            <div class="stat-value">@Model.BelowReorderCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card is-warning">
            <span class="stat-icon" aria-hidden="true">
                <svg><use href="@(iconSprite)#i-check-circle"></use></svg>
            </span>
            <div class="stat-label">Menunggu Approval</div>
            <div class="stat-value">@Model.PendingApprovals</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="table-card-header">
                <h5>Reorder Alert</h5>
                @if (canViewRestrictedReports)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Reports" asp-action="Reorder">Lihat semua</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Produk</th>
                            <th>Lokasi</th>
                            <th class="text-end">Stok</th>
                            <th class="text-end">Reorder</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.ReorderItems.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <svg aria-hidden="true"><use href="@(iconSprite)#i-empty"></use></svg>
                                    <div>Tidak ada produk di bawah reorder level.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.ReorderItems)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Sku</td>
                            <td>@item.ProductName</td>
                            <td>@item.LocationName</td>
                            <td class="text-end text-danger fw-semibold">@item.Quantity</td>
                            <td class="text-end">@item.ReorderLevel</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="table-card-header">
                <h5>Mutasi Terakhir</h5>
                @if (canViewRestrictedReports)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Reports" asp-action="Movements">Lihat semua</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Waktu</th>
                            <th>No</th>
                            <th>Produk</th>
                            <th>Lokasi</th>
                            <th class="text-end">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.RecentMovements.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <svg aria-hidden="true"><use href="@(iconSprite)#i-empty"></use></svg>
                                    <div>Belum ada mutasi stok.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.RecentMovements)
                    {
                        <tr>
                            <td class="text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@item.MovementNo</td>
                            <td>@item.Sku - @item.ProductName</td>
                            <td>@item.LocationName</td>
                            <td class="text-end">@item.Quantity</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
