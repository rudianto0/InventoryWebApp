@model PagedResult<UserListItem>
@{
    ViewData["Title"] = "Users";
    var roles = (IReadOnlyList<string>)ViewBag.Roles;
    var isActive = ViewBag.IsActive as bool?;
    var sortBy = ViewBag.SortBy as string;
    var sortDir = ViewBag.SortDir is SortDirection d ? d : SortDirection.Asc;
}

<div class="d-flex justify-content-between mb-3">
    <h4>Users</h4>
    <a class="btn btn-primary" asp-action="Create">Tambah User</a>
</div>
<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sortBy" value="@sortBy" />
    <input type="hidden" name="sortDir" value="@sortDir" />
    <div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Cari username/email..." /></div>
    <div class="col-auto">
        <select name="roleName" class="form-select">
            <option value="">Semua Role</option>
            @foreach (var role in roles)
            {
                <option value="@role" selected="@(ViewBag.RoleName == role)">@role</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="isActive" class="form-select">
            <option value="">Semua Status</option>
            <option value="true" selected="@(isActive == true)">Aktif</option>
            <option value="false" selected="@(isActive == false)">Non-aktif</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div>
</form>
<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead><tr>
            @Html.SortHeader("Username", "username", sortBy, sortDir)
            @Html.SortHeader("Nama", "fullname", sortBy, sortDir)
            @Html.SortHeader("Email", "email", sortBy, sortDir)
            @Html.SortHeader("Role", "role", sortBy, sortDir)
            @Html.SortHeader("Atasan", "parent", sortBy, sortDir)
            @Html.SortHeader("Status", "status", sortBy, sortDir)
            <th class="text-end">Aksi</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.RoleName</td>
                <td>@item.ParentName</td>
                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Non-aktif")</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@item.Id">Reset Password</a>
                    @if (item.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Non-aktifkan user ini?')">Non-aktifkan</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-3">Tidak ada user.</td></tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />
