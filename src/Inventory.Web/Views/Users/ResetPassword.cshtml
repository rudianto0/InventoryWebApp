@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}
<h4>Reset Password - @Model.UserName</h4>
<div class="row">
    <div class="col-md-5">
        <form method="post" asp-action="ResetPassword" class="card card-body shadow-sm">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Password Baru</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div>
                <button class="btn btn-primary">Reset</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Batal</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
