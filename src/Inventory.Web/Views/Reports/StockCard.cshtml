@model StockCardPageModel
@{
    ViewData["Title"] = "Stock Card";
    ViewBag.ReportKey = "";
}
<h4>Kartu Stok (Stock Card)</h4>
<partial name="_Filter" model="Model.Filter" />
@if (!Model.Filter.ProductId.HasValue)
{
    <div class="alert alert-info">Pilih produk terlebih dahulu untuk menampilkan kartu stok.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Waktu</th><th>No Mutasi</th><th>Tipe</th><th>Lokasi</th><th class="text-end">Quantity</th><th class="text-end">Saldo Berjalan</th><th>Catatan</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.MovementNo</td>
                        <td>@item.Type</td>
                        <td>@item.LocationName</td>
                        <td class="text-end">@item.Quantity.ToString("N4")</td>
                        <td class="text-end fw-semibold">@item.RunningBalance.ToString("N4")</td>
                        <td>@item.Notes</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">Belum ada mutasi untuk produk ini.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
