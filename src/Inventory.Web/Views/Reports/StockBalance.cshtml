@model PagedReportModel<StockBalanceItem>
@{
    ViewData["Title"] = Model.Title;
    ViewBag.ReportKey = Model.ReportKey;
}
<h4>@Model.Title</h4>
<partial name="_Filter" model="Model.Filter" />
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr>
                @Html.SortHeader("SKU", "sku", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Produk", "product", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Unit", "unit", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Lokasi", "location", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Branch", "branch", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Quantity", "quantity", Model.Filter.SortBy, Model.Filter.SortDir, "text-end")
                @Html.SortHeader("Update Terakhir", "updatedat", Model.Filter.SortBy, Model.Filter.SortDir)
            </tr></thead>
            <tbody>
            @foreach (var item in Model.Result.Items)
            {
                <tr>
                    <td>@item.Sku</td>
                    <td>@item.ProductName</td>
                    <td>@item.UnitName</td>
                    <td>@item.LocationName</td>
                    <td>@item.BranchCode</td>
                    <td class="text-end">@item.Quantity</td>
                    <td>@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-3">Tidak ada data.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model.Result" />
