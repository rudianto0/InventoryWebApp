@model PagedReportModel<StockMovementItem>
@{
    ViewData["Title"] = Model.Title;
    ViewBag.ReportKey = Model.ReportKey;
}
<h4>@Model.Title</h4>
<partial name="_Filter" model="Model.Filter" />
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr>
                @Html.SortHeader("Waktu", "createdat", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("No Mutasi", "movementno", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Tipe", "type", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("SKU", "sku", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Produk", "product", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Lokasi", "location", Model.Filter.SortBy, Model.Filter.SortDir)
                @Html.SortHeader("Quantity", "quantity", Model.Filter.SortBy, Model.Filter.SortDir, "text-end")
                <th>Catatan</th>
            </tr></thead>
            <tbody>
            @foreach (var item in Model.Result.Items)
            {
                <tr>
                    <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.MovementNo</td>
                    <td>@item.Type</td>
                    <td>@item.Sku</td>
                    <td>@item.ProductName</td>
                    <td>@item.LocationName</td>
                    <td class="text-end">@item.Quantity</td>
                    <td>@item.Notes</td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-3">Tidak ada mutasi pada periode ini.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model.Result" />
