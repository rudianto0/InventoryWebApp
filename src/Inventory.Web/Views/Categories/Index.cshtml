@model IReadOnlyList<Category>
@{
    ViewData["Title"] = "Categories";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between mb-3">
    <h4>Categories</h4>
    @if (isAdmin) { <a class="btn btn-primary" asp-action="Create">Tambah Kategori</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Cari kategori..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Cari</button></div>
</form>
<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead><tr><th>Nama</th><th>Deskripsi</th><th>Status</th><th class="text-end">Aksi</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Non-aktif")</span></td>
                <td class="text-end">
                    @if (isAdmin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        @if (item.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Non-aktifkan kategori ini?')">Non-aktifkan</button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted py-3">Belum ada data.</td></tr>
        }
        </tbody>
    </table>
</div>
