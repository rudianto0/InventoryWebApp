@model PagedResult<CategoryResponse>
@{
    ViewData["Title"] = "Categories";
    var isAdmin = User.IsInRole("Admin");
    var sortBy = ViewBag.SortBy as string;
    var sortDir = ViewBag.SortDir is SortDirection d ? d : SortDirection.Asc;
}

<div class="d-flex justify-content-between mb-3">
    <h4>Categories</h4>
    @if (isAdmin) { <a class="btn btn-primary" asp-action="Create">Tambah Kategori</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sortBy" value="@sortBy" />
    <input type="hidden" name="sortDir" value="@sortDir" />
    <div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Cari kategori..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Cari</button></div>
</form>
<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead><tr>
            @Html.SortHeader("Nama", "name", sortBy, sortDir)
            @Html.SortHeader("Deskripsi", "description", sortBy, sortDir)
            @Html.SortHeader("Status", "status", sortBy, sortDir)
            <th class="text-end">Aksi</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Non-aktif")</span></td>
                <td class="text-end">
                    @if (isAdmin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        @if (item.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Non-aktifkan kategori ini?')">Non-aktifkan</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hapus kategori ini? Data akan di-soft delete.')">Hapus</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted py-3">Belum ada data.</td></tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />
