@model LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-brand">
        <span class="auth-logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                <path d="m3.3 7 8.7 5 8.7-5" />
                <path d="M12 22V12" />
            </svg>
        </span>
        <span class="auth-brand-name">Inventory</span>
    </div>

    <h1 class="auth-title">Selamat datang kembali</h1>
    <p class="auth-subtitle">Masuk untuk mengelola persediaan dan transaksi stok.</p>

    <form asp-action="Login" method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

        <div class="auth-field">
            <label asp-for="UserName" class="form-label">Username</label>
            <div class="auth-input">
                <span class="auth-input-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21a8 8 0 0 0-16 0" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <input asp-for="UserName" class="form-control" autocomplete="username"
                       placeholder="Masukkan username" required autofocus />
            </div>
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="auth-input">
                <span class="auth-input-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                <input asp-for="Password" type="password" class="form-control"
                       autocomplete="current-password" placeholder="Masukkan password" required />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="form-check auth-remember">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Ingat saya</label>
        </div>

        <button type="submit" class="btn auth-submit w-100">Masuk</button>
    </form>

    <p class="auth-note">Hubungi Admin jika Anda mengalami kendala masuk.</p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
