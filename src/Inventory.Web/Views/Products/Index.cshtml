@model IReadOnlyList<ProductListItem>
@{
    ViewData["Title"] = "Products";
    var isAdmin = User.IsInRole("Admin");
    var categories = (IReadOnlyList<SelectOption>)ViewBag.Categories;
    var categoryId = ViewBag.CategoryId as Guid?;
}
<div class="d-flex justify-content-between mb-3">
    <h4>Products</h4>
    @if (isAdmin) { <a class="btn btn-primary" asp-action="Create">Tambah Produk</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Cari SKU/nama..." /></div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" asp-items="@(new SelectList(categories, "Id", "Text", categoryId))">
            <option value="">Semua Kategori</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Cari</button></div>
</form>
<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead><tr><th>SKU</th><th>Nama</th><th>Kategori</th><th>Unit</th><th class="text-end">Reorder</th><th>Status</th><th class="text-end">Aksi</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sku</td>
                <td>@item.Name</td>
                <td>@item.CategoryName</td>
                <td>@item.UnitName</td>
                <td class="text-end">@item.ReorderLevel</td>
                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Non-aktif")</span></td>
                <td class="text-end">
                    @if (isAdmin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        @if (item.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Non-aktifkan produk ini?')">Non-aktifkan</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hapus produk ini? Data akan di-soft delete.')">Hapus</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-3">Belum ada data.</td></tr>
        }
        </tbody>
    </table>
</div>
