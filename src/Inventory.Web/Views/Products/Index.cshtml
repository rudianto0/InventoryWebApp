@model IReadOnlyList<ProductListItem>
@{
    ViewData["Title"] = "Products";
    var isAdmin = User.IsInRole("Admin");
    var categories = (IReadOnlyList<SelectOption>)ViewBag.Categories;
    var categoryId = ViewBag.CategoryId as Guid?;
    var iconSprite = Url.Content("~/images/icons.svg");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <div>
        <h4 class="mb-1">Products</h4>
        <p class="text-muted mb-0 small">Kelola daftar produk, kategori, satuan, dan batas reorder.</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">Tambah Produk</a>
    }
</div>

<form method="get" class="toolbar-card">
    <input name="search" value="@ViewBag.Search" class="form-control" style="max-width: 260px" placeholder="Cari SKU atau nama..." />
    <select name="categoryId" class="form-select" style="max-width: 220px" asp-items="@(new SelectList(categories, "Id", "Text", categoryId))">
        <option value="">Semua Kategori</option>
    </select>
    <button class="btn btn-outline-secondary">Cari</button>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Nama</th>
                    <th>Kategori</th>
                    <th>Unit</th>
                    <th class="text-end">Reorder</th>
                    <th>Status</th>
                    <th class="text-end">Aksi</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Sku</td>
                    <td>@item.Name</td>
                    <td>@item.CategoryName</td>
                    <td>@item.UnitName</td>
                    <td class="text-end">@item.ReorderLevel</td>
                    <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Non-aktif")</span></td>
                    <td class="text-end text-nowrap">
                        @if (isAdmin)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Non-aktifkan produk ini?')">Non-aktifkan</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hapus produk ini? Data akan di-soft delete.')">Hapus</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg aria-hidden="true"><use href="@(iconSprite)#i-empty"></use></svg>
                            <div>Belum ada data produk.</div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
