@model IReadOnlyList<LocationResponse>
@{
    ViewData["Title"] = "Locations";
    var isAdmin = User.IsInRole("Admin");
    var type = ViewBag.Type as LocationType?;
}
<div class="d-flex justify-content-between mb-3">
    <h4>Locations</h4>
    @if (isAdmin) { <a class="btn btn-primary" asp-action="Create">Tambah Lokasi</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<LocationType>()">
            <option value="">Semua Tipe</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div>
</form>
<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead><tr><th>Kode</th><th>Nama</th><th>Tipe</th><th>Parent</th><th>Branch</th><th>Status</th><th class="text-end">Aksi</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.Type</td>
                <td>@item.ParentLocationName</td>
                <td>@item.BranchCode</td>
                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Non-aktif")</span></td>
                <td class="text-end">
                    @if (isAdmin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        @if (item.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Non-aktifkan lokasi ini?')">Non-aktifkan</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hapus lokasi ini? Data akan di-soft delete.')">Hapus</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-3">Belum ada data.</td></tr>
        }
        </tbody>
    </table>
</div>
