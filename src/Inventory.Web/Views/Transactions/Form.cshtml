@model TransactionFormModel
@{
    ViewData["Title"] = Model.Title;
    var action = Model.IsEdit ? "Edit" : "Create";
    var showHeaderLocation = !Model.ShowFromTo && Model.Mode != "opname-create";
    var isAdjustment = Model.Mode == "adjustment";
    var isOpname = Model.Mode == "opname";
}

<h4>@Model.Title @(Model.DocNo is null ? "" : $"({Model.DocNo})")</h4>

<form method="post" asp-controller="@Model.ControllerName" asp-action="@action" asp-route-id="@Model.Id" id="transaction-form">
    <input type="hidden" asp-for="Title" />
    <input type="hidden" asp-for="ControllerName" />
    <input type="hidden" asp-for="FormAction" />
    <input type="hidden" asp-for="Mode" />
    <input type="hidden" asp-for="IsEdit" />
    <input type="hidden" asp-for="ShowSupplier" />
    <input type="hidden" asp-for="ShowPurpose" />
    <input type="hidden" asp-for="ShowReason" />
    <input type="hidden" asp-for="ShowFromTo" />
    <input type="hidden" asp-for="ShowUnitCost" />
    <input type="hidden" asp-for="DocNo" />

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="card card-body shadow-sm mb-3">
        <div class="row">
            @if (Model.ShowSupplier)
            {
                <div class="col-md-4 mb-3">
                    <label asp-for="SupplierId" class="form-label">Supplier</label>
                    <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.Suppliers, "Id", "Text"))">
                        <option value="">-- pilih supplier --</option>
                    </select>
                </div>
            }
            @if (Model.ShowFromTo)
            {
                <div class="col-md-4 mb-3">
                    <label asp-for="FromLocationId" class="form-label">Lokasi Asal</label>
                    <select asp-for="FromLocationId" class="form-select" asp-items="@(new SelectList(Model.Locations, "Id", "Text"))">
                        <option value="">-- pilih lokasi --</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ToLocationId" class="form-label">Lokasi Tujuan</label>
                    <select asp-for="ToLocationId" class="form-select" asp-items="@(new SelectList(Model.Locations, "Id", "Text"))">
                        <option value="">-- pilih lokasi --</option>
                    </select>
                </div>
            }
            else if (!isOpname || Model.IsEdit)
            {
                <div class="col-md-4 mb-3">
                    <label asp-for="LocationId" class="form-label">Lokasi</label>
                    <select asp-for="LocationId" class="form-select" asp-items="@(new SelectList(Model.Locations, "Id", "Text"))"
                            disabled="@Model.IsEdit">
                        <option value="">-- pilih lokasi --</option>
                    </select>
                    @if (Model.IsEdit)
                    {
                        <input type="hidden" asp-for="LocationId" />
                    }
                </div>
            }
            else
            {
                <div class="col-md-4 mb-3">
                    <label asp-for="LocationId" class="form-label">Lokasi</label>
                    <select asp-for="LocationId" class="form-select" asp-items="@(new SelectList(Model.Locations, "Id", "Text"))">
                        <option value="">-- pilih lokasi --</option>
                    </select>
                </div>
            }
            <div class="col-md-3 mb-3">
                <label asp-for="Date" class="form-label">Tanggal</label>
                <input asp-for="Date" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>
            @if (Model.ShowPurpose)
            {
                <div class="col-md-5 mb-3">
                    <label asp-for="Purpose" class="form-label">Purpose</label>
                    <input asp-for="Purpose" class="form-control" />
                </div>
            }
            @if (Model.ShowReason)
            {
                <div class="col-md-5 mb-3">
                    <label asp-for="Reason" class="form-label">Alasan</label>
                    <input asp-for="Reason" class="form-control" />
                </div>
            }
            <div class="col-12 mb-2">
                <label asp-for="Notes" class="form-label">Catatan</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    @if (isAdjustment)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Detail Adjustment</span>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow('adjustment')">Tambah Baris</button>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" id="adjustment-table">
                    <thead><tr><th style="width:40%">Produk</th><th>Counted Qty</th><th>Catatan</th><th></th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < Model.AdjustmentLines.Count; i++)
                    {
                        <tr data-row>
                            <td>
                                <select name="AdjustmentLines[@i].ProductId" class="form-select">
                                    <option value="0">-- pilih produk --</option>
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id" selected="@(Model.AdjustmentLines[i].ProductId == product.Id)">@product.Text</option>
                                    }
                                </select>
                            </td>
                            <td><input name="AdjustmentLines[@i].CountedQuantity" value="@Model.AdjustmentLines[i].CountedQuantity" type="number" step="0.0001" min="0" class="form-control" /></td>
                            <td><input name="AdjustmentLines[@i].Notes" value="@Model.AdjustmentLines[i].Notes" class="form-control" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">Hapus</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <template id="adjustment-template">
            <tr data-row>
                <td>
                    <select name="AdjustmentLines[__index__].ProductId" class="form-select">
                        <option value="0">-- pilih produk --</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product.Id">@product.Text</option>
                        }
                    </select>
                </td>
                <td><input name="AdjustmentLines[__index__].CountedQuantity" type="number" step="0.0001" min="0" value="0" class="form-control" /></td>
                <td><input name="AdjustmentLines[__index__].Notes" class="form-control" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">Hapus</button></td>
            </tr>
        </template>
    }
    else if (isOpname)
    {
        if (Model.IsEdit && Model.OpnameLines.Count > 0)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">Hasil Hitung Fisik</div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>SKU</th><th>Produk</th><th>Unit</th><th class="text-end">System Qty</th><th>Counted Qty</th><th>Catatan</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < Model.OpnameLines.Count; i++)
                        {
                            <tr>
                                <td>@Model.OpnameLines[i].Sku</td>
                                <td>@Model.OpnameLines[i].ProductName</td>
                                <td>@Model.OpnameLines[i].UnitName</td>
                                <td class="text-end">@Model.OpnameLines[i].SystemQuantity.ToString("N4")</td>
                                <td>
                                    <input type="hidden" name="OpnameLines[@i].DetailId" value="@Model.OpnameLines[i].DetailId" />
                                    <input name="OpnameLines[@i].CountedQuantity" value="@Model.OpnameLines[i].CountedQuantity" type="number" step="0.0001" min="0" class="form-control" />
                                </td>
                                <td><input name="OpnameLines[@i].Notes" value="@Model.OpnameLines[i].Notes" class="form-control" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">Sesi opname akan mem-snapshot seluruh stok pada lokasi terpilih. Setelah dibuat, Anda akan diarahkan ke form input hasil hitung.</div>
        }
    }
    else
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Detail Produk</span>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow('document')">Tambah Baris</button>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" id="document-table">
                    <thead>
                        <tr>
                            <th style="width:35%">Produk</th>
                            <th>Quantity</th>
                            @if (Model.ShowUnitCost) { <th>Unit Cost</th> }
                            <th>Catatan</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr data-row>
                            <td>
                                <select name="Lines[@i].ProductId" class="form-select">
                                    <option value="0">-- pilih produk --</option>
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id" selected="@(Model.Lines[i].ProductId == product.Id)">@product.Text</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" type="number" step="0.0001" min="0" class="form-control" /></td>
                            @if (Model.ShowUnitCost)
                            {
                                <td><input name="Lines[@i].UnitCost" value="@Model.Lines[i].UnitCost" type="number" step="0.0001" min="0" class="form-control" /></td>
                            }
                            <td><input name="Lines[@i].Notes" value="@Model.Lines[i].Notes" class="form-control" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">Hapus</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <template id="document-template">
            <tr data-row>
                <td>
                    <select name="Lines[__index__].ProductId" class="form-select">
                        <option value="0">-- pilih produk --</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product.Id">@product.Text</option>
                        }
                    </select>
                </td>
                <td><input name="Lines[__index__].Quantity" type="number" step="0.0001" min="0" value="0" class="form-control" /></td>
                @if (Model.ShowUnitCost)
                {
                    <td><input name="Lines[__index__].UnitCost" type="number" step="0.0001" min="0" class="form-control" /></td>
                }
                <td><input name="Lines[__index__].Notes" class="form-control" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">Hapus</button></td>
            </tr>
        </template>
    }

    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Simpan</button>
        <a class="btn btn-outline-secondary" asp-controller="@Model.ControllerName" asp-action="Index">Batal</a>
    </div>
</form>

@section Scripts {
<script>
    let rowIndex = 1000;

    function addRow(kind) {
        const id = kind === 'adjustment' ? 'adjustment-template' : 'document-template';
        const tableId = kind === 'adjustment' ? 'adjustment-table' : 'document-table';
        const template = document.getElementById(id);
        const tbody = document.querySelector('#' + tableId + ' tbody');
        const html = template.innerHTML.replaceAll('__index__', rowIndex++);
        tbody.insertAdjacentHTML('beforeend', html);
    }

    function reindex(tableId, prefix) {
        document.querySelectorAll('#' + tableId + ' tbody tr[data-row]').forEach((row, index) => {
            row.querySelectorAll('[name]').forEach(element => {
                element.name = element.name.replace(new RegExp('^' + prefix + '\\[[^\\]]+\\]'), prefix + '[' + index + ']');
            });
        });
    }

    document.getElementById('transaction-form')?.addEventListener('submit', () => {
        reindex('document-table', 'Lines');
        reindex('adjustment-table', 'AdjustmentLines');
    });
</script>
}
