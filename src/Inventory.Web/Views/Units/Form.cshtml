@model UnitFormModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Unit" : "Tambah Unit";
}
<h4>@ViewData["Title"]</h4>
<div class="row">
    <div class="col-md-5">
        <form method="post" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label">Kode</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nama</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div>
                <button class="btn btn-primary">Simpan</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Batal</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
