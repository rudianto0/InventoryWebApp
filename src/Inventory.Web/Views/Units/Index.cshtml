@model IReadOnlyList<UnitResponse>
@{
    ViewData["Title"] = "Units";
    var isAdmin = User.IsInRole("Admin");
}
<div class="d-flex justify-content-between mb-3">
    <h4>Units</h4>
    @if (isAdmin) { <a class="btn btn-primary" asp-action="Create">Tambah Unit</a> }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Cari kode/nama..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Cari</button></div>
</form>
<div class="card shadow-sm">
    <table class="table table-hover mb-0">
        <thead><tr><th>Kode</th><th>Nama</th><th class="text-end">Aksi</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td class="text-end">
                    @if (isAdmin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hapus unit ini? Data akan di-soft delete.')">Hapus</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="3" class="text-center text-muted py-3">Belum ada data.</td></tr>
        }
        </tbody>
    </table>
</div>
