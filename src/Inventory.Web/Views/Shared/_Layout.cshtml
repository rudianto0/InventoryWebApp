@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">Inventory</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (isAuthenticated)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Master Data</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Categories</a></li>
                                    <li><a class="dropdown-item" asp-controller="Units" asp-action="Index">Units</a></li>
                                    <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Products</a></li>
                                    <li><a class="dropdown-item" asp-controller="Locations" asp-action="Index">Locations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Transactions</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="StockIns" asp-action="Index">Stock In</a></li>
                                    <li><a class="dropdown-item" asp-controller="StockOuts" asp-action="Index">Stock Out</a></li>
                                    <li><a class="dropdown-item" asp-controller="StockTransfers" asp-action="Index">Stock Transfer</a></li>
                                    <li><a class="dropdown-item" asp-controller="StockAdjustments" asp-action="Index">Stock Adjustment</a></li>
                                    <li><a class="dropdown-item" asp-controller="StockOpnames" asp-action="Index">Stock Opname</a></li>
                                </ul>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("SPV") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Approvals" asp-action="Index">Approvals</a></li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Reports</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="StockBalance">Stock Balance</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="StockCard">Stock Card</a></li>
                                    @if (!User.IsInRole("Staff"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Movements">Movements</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Reorder">Reorder Alert</a></li>
                                    }
                                </ul>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("Auditor"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="AuditLogs" asp-action="Index">Audit Trail</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="navbar-text me-3">@User.Identity!.Name</span>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Ganti Password</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4">
            &copy; 2026 - Inventory Management
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
