@model dynamic
@{
    var currentPage = (int)Model.Page;
    var totalPages = (int)Model.TotalPages;
    var hasPrevious = (bool)Model.HasPrevious;
    var hasNext = (bool)Model.HasNext;
    var parts = Context.Request.Query
        .Where(kv => !string.Equals(kv.Key, "page", StringComparison.OrdinalIgnoreCase))
        .SelectMany(kv => kv.Value.Select(v => $"{kv.Key}={Uri.EscapeDataString(v ?? string.Empty)}"))
        .ToList();
    var prefix = parts.Count == 0 ? "?" : "?" + string.Join("&", parts) + "&";
}
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            <li class="page-item @(hasPrevious ? "" : "disabled")">
                <a class="page-link" href="@(prefix + "page=" + (currentPage - 1))">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Halaman @currentPage dari @totalPages</span></li>
            <li class="page-item @(hasNext ? "" : "disabled")">
                <a class="page-link" href="@(prefix + "page=" + (currentPage + 1))">Next</a>
            </li>
        </ul>
    </nav>
}
