@model PagedResult<AuditListItem>
@{
    ViewData["Title"] = "Audit Trail";
    var entities = (IReadOnlyList<string>)ViewBag.EntityNames;
    var actions = (string[])ViewBag.Actions;
    var filter = ViewBag.Filter as AuditFilter;
    var sortBy = filter?.SortBy;
    var sortDir = filter?.SortDir ?? SortDirection.Asc;
}
<h4>Audit Trail</h4>
<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sortBy" value="@sortBy" />
    <input type="hidden" name="sortDir" value="@sortDir" />
    <div class="col-auto">
        <select name="EntityName" class="form-select form-select-sm">
            <option value="">Semua Entity</option>
            @foreach (var entity in entities)
            {
                <option value="@entity" selected="@(filter?.EntityName == entity)">@entity</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="Action" class="form-select form-select-sm">
            <option value="">Semua Action</option>
            @foreach (var action in actions)
            {
                <option value="@action" selected="@(filter?.Action == action)">@action</option>
            }
        </select>
    </div>
    <div class="col-auto"><input name="UserId" value="@filter?.UserId" type="number" min="1" placeholder="User ID" class="form-control form-control-sm" /></div>
    <div class="col-auto"><input type="date" name="From" value="@filter?.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div class="col-auto"><input type="date" name="To" value="@filter?.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div class="col-auto"><button class="btn btn-sm btn-outline-primary">Filter</button></div>
</form>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr>
                @Html.SortHeader("Waktu", "createdat", sortBy, sortDir)
                @Html.SortHeader("Entity", "entity", sortBy, sortDir)
                <th>Entity ID</th>
                @Html.SortHeader("Action", "action", sortBy, sortDir)
                <th>User</th>
                @Html.SortHeader("IP", "ip", sortBy, sortDir)
                <th class="text-end">Aksi</th>
            </tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@item.EntityName</td>
                    <td>@item.EntityId</td>
                    <td>@item.Action</td>
                    <td>@item.UserName</td>
                    <td>@item.IpAddress</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detail</a></td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-3">Tidak ada audit log.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model" />
